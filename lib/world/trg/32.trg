#3200
Zone32 River Current Ambient~
2 b 4
~
switch %random.5%
  case 1
    %echo% The steady current gathers a loose raft of leaves and carries it eastward.
  break
  case 2
    %echo% Water slaps hollowly against the old stonework before sliding away downstream.
  break
  case 3
    %echo% A waterlogged branch rolls once in the current and vanishes beneath the darker water.
  break
  case 4
    %echo% The muted rumble of Midgaard traffic reaches the river from somewhere above.
  break
  case 5
    %echo% A pale fish turns beneath the surface, flashing silver for an instant before disappearing.
  break
done
~
#3201
Zone32 Levee Steps Ambient~
2 b 4
~
switch %random.5%
  case 1
    %echo% A mooring line creaks against an iron ring as the current tugs at something downstream.
  break
  case 2
    %echo% A dockworker's distant call carries down from the levee and fades between the stone walls.
  break
  case 3
    %echo% A heron gives a harsh cry from the bank before settling back into patient silence.
  break
  case 4
    %echo% Somewhere above, cargo scrapes across stone and a rope pulley answers with a wooden groan.
  break
  case 5
    %echo% Small waves climb the lowest levee step and retreat, leaving the stone shining.
  break
done
~
#3202
Zone32 Warehouse Gate Ambient~
2 b 4
~
switch %random.5%
  case 1
    %echo% The warehouse pilings knock softly as the river presses against them.
  break
  case 2
    %echo% A shutter bangs once above the channel, followed by the muffled sound of workers moving cargo.
  break
  case 3
    %echo% The eastern iron river gate gives a deep metallic groan as water pushes through its bars.
  break
  case 4
    %echo% A broken scrap of packing wood spins past on the current toward western Midgaard.
  break
  case 5
    %echo% Cool air drifts from the eastern passage, carrying the mineral smell of wet stone.
  break
done
~
$~
